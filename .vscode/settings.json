{
    // VS2022 已卸载，改用 llvm-mingw 的 Clang 22 工具链（x86_64, UCRT）
    "cmake.generator": "MinGW Makefiles",
    "cmake.configureSettings": {
        "CMAKE_C_COMPILER": "C:/Users/Carect/AppData/Local/Microsoft/WinGet/Packages/MartinStorsjo.LLVM-MinGW.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/llvm-mingw-20260616-ucrt-x86_64/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/Users/Carect/AppData/Local/Microsoft/WinGet/Packages/MartinStorsjo.LLVM-MinGW.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/llvm-mingw-20260616-ucrt-x86_64/bin/clang++.exe"
    },
    "cmake.environment": {
        "PATH": "C:/Users/Carect/AppData/Local/Microsoft/WinGet/Packages/MartinStorsjo.LLVM-MinGW.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/llvm-mingw-20260616-ucrt-x86_64/bin;${env:PATH}"
    },
    "cmake.buildDirectory": "${workspaceFolder}/build",

    // 双引擎并存：clangd 负责跳转/补全/诊断，cpptools IntelliSense 只用于
    // 右键"Create Definition/Declaration"等代码生成功能
    "clangd.path": "C:/Users/Carect/AppData/Local/Microsoft/WinGet/Packages/MartinStorsjo.LLVM-MinGW.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/llvm-mingw-20260616-ucrt-x86_64/bin/clangd.exe",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--background-index",
        "--header-insertion=never"
    ],
    // cpptools：恢复 IntelliSense 以获得"创建定义/声明"，但关闭其诊断和格式化，
    // 避免与 clangd 产生重复的红色波浪线和格式行为冲突（保留其调试功能）
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.intelliSenseUpdateDelay": 2000,
    // 格式化统一由 clangd 负责（clang 22 的 clang-format，读取项目 .clang-format）。
    // 全局设置里 [cpp] 指定了 cpptools 为默认格式化器，但本方案已禁用其格式化，
    // 故在此覆盖，否则 format-on-save 会静默失效
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "C_Cpp.default.compilerPath": "C:/Users/Carect/AppData/Local/Microsoft/WinGet/Packages/MartinStorsjo.LLVM-MinGW.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/llvm-mingw-20260616-ucrt-x86_64/bin/clang.exe"
}
